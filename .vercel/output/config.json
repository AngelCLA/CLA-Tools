{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/upload-pdf/?$",
			"dest": "_render"
		},
		{
			"src": "^/tools/ebooks/?$",
			"dest": "_render"
		},
		{
			"src": "^/tools/generador-acta/?$",
			"dest": "_render"
		},
		{
			"src": "^/tools/merge-pdf/?$",
			"dest": "_render"
		},
		{
			"src": "^/tools/text-html/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		}
	]
}