---
import Layout from "../../layouts/Layout.astro";
import textHtmlScript from "../../assets/scripts/text-html-converter.js?raw";
---

<Layout
  title="Convertir Texto a HTML | CLA Tools"
  description="Convierte texto con formato a código HTML conservando estilos y estructura. Herramienta gratuita para generar HTML limpio."
  keywords="texto a html, convertir texto html, generador html, formatear html, texto a codigo"
>
  <div class="flex flex-col min-h-full items-center justify-center py-8 px-4">
    <div
      class="w-full max-w-6xl bg-white dark:bg-zinc-800 shadow-2xl rounded-xl p-6 sm:p-8 md:p-12"
    >
      <!-- Header -->
      <h1
        class="text-3xl sm:text-4xl md:text-5xl font-bold text-purple-600 dark:text-purple-400 mb-4 text-center"
      >
        Convertidor de Texto a HTML
      </h1>
      <p
        class="mb-6 text-base sm:text-lg md:text-xl text-zinc-700 dark:text-zinc-300 text-center"
      >
        Pega texto desde Word o Google Docs y mantén el formato original
      </p>

      <!-- Instructions -->
      <div
        class="bg-purple-50 dark:bg-purple-900/20 border border-purple-200 dark:border-purple-700 rounded-lg p-4 sm:p-6 mb-6"
      >
        <p class="font-semibold text-purple-800 dark:text-purple-300 mb-2">
          📌 Instrucciones:
        </p>
        <ol
          class="list-decimal list-inside space-y-2 text-sm sm:text-base text-zinc-700 dark:text-zinc-300"
        >
          <li>Copia el texto de Word, Google Docs u otro editor de texto.</li>
          <li>
            Pega directamente en el área de texto (con <kbd
              class="px-2 py-1 bg-zinc-200 dark:bg-zinc-700 rounded text-xs"
              >Ctrl+V</kbd
            > o <kbd
              class="px-2 py-1 bg-zinc-200 dark:bg-zinc-700 rounded text-xs"
              >⌘+V</kbd
            >).
          </li>
          <li>
            El formato (negritas, cursivas, colores, etc.) se mantendrá
            automáticamente.
          </li>
          <li>Puedes editar el texto o añadir más contenido si lo deseas.</li>
          <li>Haz clic en "Generar HTML" para obtener el código HTML.</li>
        </ol>
      </div>

      <!-- Tabs -->
      <div class="flex border-b border-zinc-300 dark:border-zinc-600 mb-6">
        <button
          data-tab="editor"
          class="px-6 py-3 cursor-pointer font-semibold border-b-2 border-purple-600 text-purple-600 dark:border-purple-400 dark:text-purple-400 transition"
        >
          Editor de Texto
        </button>
        <button
          data-tab="html"
          class="px-6 py-3 cursor-pointer font-semibold border-b-2 border-transparent text-zinc-600 dark:text-zinc-400 hover:text-purple-600 dark:hover:text-purple-400 transition"
        >
          Código HTML
        </button>
        <button
          data-tab="preview"
          class="px-6 py-3 cursor-pointer font-semibold border-b-2 border-transparent text-zinc-600 dark:text-zinc-400 hover:text-purple-600 dark:hover:text-purple-400 transition"
        >
          Vista Previa
        </button>
      </div>

      <!-- Editor Tab Content -->
      <div data-tab-content="editor">
        <!-- Toolbar -->
        <div
          class="flex flex-wrap gap-2 p-3 bg-purple-400/20 dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700 rounded-t-lg"
        >
          <button
            data-command="bold"
            class="p-2 hover:bg-purple-200 dark:hover:bg-zinc-700 rounded transition cursor-pointer"
            title="Negrita"
          >
            <i class="fas fa-bold"></i>
          </button>
          <button
            data-command="italic"
            class="p-2 hover:bg-purple-200 dark:hover:bg-zinc-700 rounded transition cursor-pointer"
            title="Cursiva"
          >
            <i class="fas fa-italic"></i>
          </button>
          <button
            data-command="underline"
            class="p-2 hover:bg-purple-200 dark:hover:bg-zinc-700 rounded transition cursor-pointer"
            title="Subrayado"
          >
            <i class="fas fa-underline"></i>
          </button>
          <button
            data-command="strikeThrough"
            class="p-2 hover:bg-purple-200 dark:hover:bg-zinc-700 rounded transition cursor-pointer"
            title="Tachado"
          >
            <i class="fas fa-strikethrough"></i>
          </button>
          <div class="w-px bg-zinc-300 dark:bg-zinc-600"></div>
          <button
            data-command="foreColor"
            data-value="#FF0000"
            class="p-2 hover:bg-purple-200 dark:hover:bg-zinc-700 rounded transition cursor-pointer"
            title="Color de texto"
          >
            <i class="fas fa-font" style="color: #EF4444;"></i>
          </button>
          <button
            data-command="backColor"
            data-value="#FFFF00"
            class="p-2 hover:bg-purple-200 dark:hover:bg-zinc-700 rounded transition cursor-pointer"
            title="Resaltado"
          >
            <i class="fas fa-highlighter" style="color: #FBBF24;"></i>
          </button>
          <div class="w-px bg-zinc-300 dark:bg-zinc-600"></div>
          <button
            data-command="formatBlock"
            data-value="h1"
            class="px-3 py-2 text-sm font-bold hover:bg-purple-200 dark:hover:bg-zinc-700 rounded transition cursor-pointer"
            title="Título 1"
          >
            H1
          </button>
          <button
            data-command="formatBlock"
            data-value="h2"
            class="px-3 py-2 text-sm font-bold hover:bg-purple-200 dark:hover:bg-zinc-700 rounded transition cursor-pointer"
            title="Título 2"
          >
            H2
          </button>
          <button
            data-command="formatBlock"
            data-value="h3"
            class="px-3 py-2 text-sm font-bold hover:bg-purple-200 dark:hover:bg-zinc-700 rounded transition cursor-pointer"
            title="Título 3"
          >
            H3
          </button>
          <button
            data-command="formatBlock"
            data-value="p"
            class="px-3 py-2 text-sm font-bold hover:bg-purple-200 dark:hover:bg-zinc-700 rounded transition cursor-pointer"
            title="Párrafo"
          >
            P
          </button>
          <div class="w-px bg-zinc-300 dark:bg-zinc-600"></div>
          <button
            data-command="insertUnorderedList"
            class="p-2 hover:bg-purple-200 dark:hover:bg-zinc-700 rounded transition cursor-pointer"
            title="Lista con viñetas"
          >
            <i class="fas fa-list-ul"></i>
          </button>
          <button
            data-command="insertOrderedList"
            class="p-2 hover:bg-purple-200 dark:hover:bg-zinc-700 rounded transition cursor-pointer"
            title="Lista numerada"
          >
            <i class="fas fa-list-ol"></i>
          </button>
          <div class="w-px bg-zinc-300 dark:bg-zinc-600"></div>
          <button
            data-command="justifyLeft"
            class="p-2 hover:bg-purple-200 dark:hover:bg-zinc-700 rounded transition cursor-pointer"
            title="Alinear a la izquierda"
          >
            <i class="fas fa-align-left"></i>
          </button>
          <button
            data-command="justifyCenter"
            class="p-2 hover:bg-purple-200 dark:hover:bg-zinc-700 rounded transition cursor-pointer"
            title="Centrar"
          >
            <i class="fas fa-align-center"></i>
          </button>
          <button
            data-command="justifyRight"
            class="p-2 hover:bg-purple-200 dark:hover:bg-zinc-700 rounded transition cursor-pointer"
            title="Alinear a la derecha"
          >
            <i class="fas fa-align-right"></i>
          </button>
          <button
            data-command="justifyFull"
            class="p-2 hover:bg-purple-200 dark:hover:bg-zinc-700 rounded transition cursor-pointer"
            title="Justificar"
          >
            <i class="fas fa-align-justify"></i>
          </button>
          <div class="w-px bg-zinc-300 dark:bg-zinc-600"></div>
          <button
            data-command="createLink"
            class="p-2 hover:bg-purple-200 dark:hover:bg-zinc-700 rounded transition cursor-pointer"
            title="Insertar enlace"
          >
            <i class="fas fa-link"></i>
          </button>
          <button
            data-command="undo"
            class="p-2 hover:bg-purple-200 dark:hover:bg-zinc-700 rounded transition cursor-pointer"
            title="Deshacer"
          >
            <i class="fas fa-undo"></i>
          </button>
          <button
            data-command="redo"
            class="p-2 hover:bg-purple-200 dark:hover:bg-zinc-700 rounded transition cursor-pointer"
            title="Rehacer"
          >
            <i class="fas fa-redo"></i>
          </button>
        </div>

        <!-- Editor -->
        <div
          id="editor"
          contenteditable="true"
          spellcheck="true"
          class="min-h-100 p-6 bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700 rounded-b-lg focus:outline-none focus:ring-2 focus:ring-purple-500 dark:focus:ring-purple-400 text-zinc-900 dark:text-zinc-100"
        >
          <p><br /></p>
        </div>

        <!-- Editor Actions -->
        <div
          class="flex flex-col sm:flex-row gap-3 mt-6 justify-center items-center"
        >
          <button
            id="generate-html-btn"
            class="px-6 py-3 cursor-pointer bg-purple-600 hover:bg-purple-700 text-white font-semibold rounded-lg transition shadow-md hover:shadow-lg w-full sm:w-auto"
          >
            📋 Generar HTML
          </button>
          <button
            id="generate-moodle-btn"
            class="px-6 py-3 cursor-pointer bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition shadow-md hover:shadow-lg w-full sm:w-auto"
          >
            🎓 Generar para Moodle
          </button>
          <button
            id="clear-editor-btn"
            class="px-6 py-3 cursor-pointer bg-red-600 hover:bg-red-700 text-white font-semibold rounded-lg transition shadow-md hover:shadow-lg w-full sm:w-auto"
          >
            🗑️ Limpiar Editor
          </button>
        </div>
      </div>

      <!-- HTML Tab Content -->
      <div data-tab-content="html" class="hidden">
        <textarea
          id="html-output"
          readonly
          class="w-full min-h-100 p-6 bg-zinc-50 dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700 rounded-lg font-mono text-sm text-zinc-900 dark:text-zinc-100 focus:outline-none focus:ring-2 focus:ring-purple-500 dark:focus:ring-purple-400"
          placeholder="El código HTML aparecerá aquí..."></textarea>

        <div
          class="flex flex-col sm:flex-row gap-3 mt-6 justify-center items-center"
        >
          <button
            id="copy-html-btn"
            class="px-6 py-3 cursor-pointer bg-green-600 hover:bg-green-700 text-white font-semibold rounded-lg transition shadow-md hover:shadow-lg w-full sm:w-auto"
          >
            📋 Copiar HTML
          </button>
          <button
            id="download-html-btn"
            class="px-6 py-3 cursor-pointer bg-purple-600 hover:bg-purple-700 text-white font-semibold rounded-lg transition shadow-md hover:shadow-lg w-full sm:w-auto"
          >
            💾 Descargar archivo .html
          </button>
        </div>
      </div>

      <!-- Preview Tab Content -->
      <div data-tab-content="preview" class="hidden">
        <div
          class="bg-zinc-50 dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700 rounded-lg p-8 min-h-100"
        >
          <p
            class="text-sm font-semibold text-purple-600 dark:text-purple-400 mb-4"
          >
            Vista previa del contenido HTML:
          </p>
          <div
            id="html-preview"
            class="prose dark:prose-invert max-w-none text-zinc-900 dark:text-zinc-100"
          >
          </div>
        </div>
      </div>

      <!-- Success Message -->
      <div
        id="success-message"
        class="hidden fixed bottom-8 right-8 bg-green-500 text-white px-6 py-3 rounded-lg shadow-lg font-semibold animate-fade-in"
      >
        ✅ ¡HTML generado exitosamente!
      </div>

      <!-- Error Message -->
      <div
        id="error-message"
        class="hidden fixed bottom-8 right-8 bg-red-500 text-white px-6 py-3 rounded-lg shadow-lg font-semibold animate-fade-in"
      >
        ❌ Error al procesar el texto.
      </div>
    </div>
  </div>
</Layout>

<script is:inline define:vars={{ textHtmlScript: textHtmlScript }}>
  eval(textHtmlScript);
</script>
