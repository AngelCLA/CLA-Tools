---
const {
  videoId,
  title = "Cómo usar esta herramienta",
  platform = "youtube", // youtube | vimeo | local
} = Astro.props;

let videoSrc = "";

if (platform === "youtube") {
  videoSrc =
    `https://www.youtube-nocookie.com/embed/${videoId}` +
    `?controls=1` +
    `&rel=0` +
    `&modestbranding=1` +
    `&playsinline=1` +
    `&iv_load_policy=3`;
}

if (platform === "vimeo") {
  videoSrc = `https://player.vimeo.com/video/${videoId}?title=0&byline=0&portrait=0`;
}

if (platform === "local") {
  videoSrc = videoId;
}
---

<div id="floating-tutorial" class="fixed bottom-6 right-6 z-50">
  <!-- Botón flotante minimalista -->
  <button
    id="tutorial-toggle"
    class="group flex items-center gap-2 bg-white dark:bg-zinc-800 hover:bg-zinc-50 dark:hover:bg-zinc-700 text-zinc-700 dark:text-zinc-200 pl-3 pr-4 py-2.5 rounded-full shadow-lg border border-zinc-200 dark:border-zinc-700 transition-all duration-200 text-sm font-medium"
  >
    <svg class="w-4 h-4 text-purple-600 dark:text-purple-400" fill="currentColor" viewBox="0 0 20 20">
      <path d="M6 4l10 6-10 6V4z" />
    </svg>
    <span>{title}</span>
  </button>

  <!-- Panel del video -->
  <div
    id="tutorial-panel"
    class="hidden absolute bottom-16 right-0 w-80 sm:w-96 bg-white dark:bg-zinc-900 rounded-2xl shadow-2xl overflow-hidden border border-zinc-200 dark:border-zinc-700 transition-all duration-300"
  >
    <!-- Header minimalista -->
    <div
      id="tutorial-header"
      class="flex items-center justify-between px-4 py-3 border-b border-zinc-200 dark:border-zinc-700"
    >
      <div class="flex items-center gap-2">
        <div class="w-1.5 h-1.5 rounded-full bg-purple-600 animate-pulse"></div>
        <span class="text-sm font-medium text-zinc-700 dark:text-zinc-300">
          Tutorial (En desarrollo)
        </span>
      </div>
      <button
        id="tutorial-close"
        class="text-zinc-400 hover:text-zinc-600 dark:hover:text-zinc-200 transition-colors"
        aria-label="Cerrar tutorial"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Video container -->
    <div
      id="tutorial-video-wrapper"
      class="relative w-full aspect-video bg-zinc-950"
    >
      {platform === "local" ? (
        <video controls class="w-full h-full" preload="metadata">
          <source src={videoSrc} type="video/mp4" />
        </video>
      ) : (
        <>
          <!-- Overlay minimalista -->
          <button
            id="tutorial-play"
            class="absolute inset-0 flex items-center justify-center bg-gradient-to-br from-purple-600/20 to-blue-600/20 backdrop-blur-sm hover:backdrop-blur-md transition-all duration-300 group"
            aria-label="Reproducir tutorial"
          >
            <div class="flex flex-col items-center gap-3">
              <div class="w-16 h-16 flex items-center justify-center rounded-full bg-zinc-800/40 shadow-xl group-hover:scale-110 transition-transform duration-300">
                <svg
                  class="w-7 h-7 text-purple-600  ml-1"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path d="M6 4l10 6-10 6V4z" />
                </svg>
              </div>
              <span class="text-sm font-medium text-white/90 px-3 py-1 rounded-full bg-black/30 backdrop-blur-sm">
                Ver tutorial
              </span>
            </div>
          </button>

          <!-- Iframe -->
          <iframe
            id="tutorial-iframe"
            class="w-full h-full hidden"
            src={videoSrc}
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </>
      )}
    </div>
  </div>
</div>

<script is:inline>
  const toggle = document.getElementById("tutorial-toggle");
  const panel = document.getElementById("tutorial-panel");
  const closeBtn = document.getElementById("tutorial-close");
  const playBtn = document.getElementById("tutorial-play");
  const iframe = document.getElementById("tutorial-iframe");
  const header = document.getElementById("tutorial-header");
  const floatingTutorial = document.getElementById("floating-tutorial");

  /* Verificar si ya fue cerrado anteriormente
  if (localStorage.getItem("cla_hide_tutorial")) {
    floatingTutorial.style.display = "none";
  }
    */

  // Toggle panel con animación
  toggle?.addEventListener("click", () => {
    const isHidden = panel.classList.contains("hidden");
    if (isHidden) {
      panel.classList.remove("hidden");
      setTimeout(() => panel.classList.add("scale-100", "opacity-100"), 10);
    } else {
      panel.classList.remove("scale-100", "opacity-100");
      setTimeout(() => panel.classList.add("hidden"), 200);
    }
  });

  // Cerrar panel y guardar preferencia
  closeBtn?.addEventListener("click", () => {
    localStorage.setItem("cla_hide_tutorial", "1");
    floatingTutorial.style.display = "none";
  });

  // Reproducir video (mantener header visible)
  playBtn?.addEventListener("click", () => {
    iframe.src += "&autoplay=1";
    iframe.classList.remove("hidden");
    playBtn.classList.add("hidden");
    // No ocultamos el header para mantener el botón de cerrar accesible
  });

  // Cerrar al hacer clic fuera (solo cierra el panel, no guarda preferencia)
  document.addEventListener("click", (e) => {
    if (!floatingTutorial?.contains(e.target) && !panel.classList.contains("hidden")) {
      panel.classList.add("hidden");
    }
  });
</script>