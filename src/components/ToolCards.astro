---
const tools = [
  {
    title: "DOCX a GIFT",
    slug: "docx-to-gift",
    description:
      "Convierte documentos de Word en formato GIFT, listo para importar preguntas y exámenes en Moodle sin reprocesar contenido.",
    icon: "fas fa-file-word",
    href: "/tools/docx-gift",
  },
  {
    title: "Texto a HTML",
    slug: "text-to-html",
    description:
      "Transforma texto con formato en HTML limpio y estructurado, ideal para pegar contenido en plataformas educativas, LMS o sitios web.",
    icon: "fas fa-code",
    href: "/tools/text-html",
  },
  {
    title: "Unir PDF",
    slug: "merge-pdf",
    description:
      "Combina varios archivos PDF en un solo documento de forma rápida, perfecta para entregables, guías y material académico.",
    icon: "fas fa-file-pdf",
    href: "/tools/merge-pdf",
  },
  {
    title: "Generador de Actas",
    slug: "generador-acta",
    description:
      "Crea actas de acuerdos académicos con formato profesional. Personaliza criterios de evaluación, unidades y evidencias. ",
    icon: "fas fa-file-signature",
    href: "/tools/generador-acta",
  },
  {
    title: "Formularios",
    slug: "forms",
    description:
      "Portal de formularios institucionales para recopilar información de forma ordenada y estandarizada.",
    icon: "fas fa-clipboard-list",
    href: "https://forms-upmys.vercel.app/",
  },
  {
    title: "Ebooks",
    slug: "ebooks",
    description: "Portal de generacion de ebooks",
    icon: "fas fa-book",
    href: "https://ebooks-upmys.vercel.app/",
  },
  {
    title: "Iframes",
    slug: "iframes",
    description: "Portal de generacion de iframes",
    icon: "fas fa-iframe",
    href: "/tools/iframes-moodle",
  },
];
---

<div
  id="tools-title"
  class="mx-auto min-h-screen px-6 text-start mb-12 flex flex-col justify-center items-center"
>
  <h3
    class="text-gradient mb-8 text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight bg-linear-to-r from-purple-400 via-pink-500 to-purple-600 bg-clip-text text-transparent"
  >
    Herramientas Disponibles
  </h3>
  <p
    class="mb-12 text-lg text-gray-600 dark:text-gray-300 max-w-4xl text-center"
  >
    Herramientas 100% gratuitas que funcionan directamente en tu navegador. Sin
    registro, sin instalación y con total privacidad.
  </p>

  <section
    id="tools"
    class="max-w-7xl mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 items-center"
  >
    {
      tools.map((tool) => (
        <a
          href={tool.href}
          data-slug={tool.slug}
          class="tool-card group relative rounded-2xl bg-white p-6 h-full flex flex-col
         transition-all duration-300 ease-out
         dark:bg-zinc-800/20"
        >
          <div class="mb-4 text-3xl text-purple-600 dark:text-purple-400">
            <i class={tool.icon} />
          </div>

          <h2 class="mb-2 text-lg font-semibold text-zinc-900 dark:text-zinc-100">
            {tool.title}
          </h2>

          <p class="text-sm text-zinc-600 dark:text-zinc-400">
            {tool.description}
          </p>
        </a>
      ))
    }

    <div
      class="rounded-2xl bg-zinc-100 p-6 text-center
       opacity-60 h-full flex flex-col dark:bg-zinc-800"
    >
      <div class="mb-4 text-3xl text-zinc-500 dark:text-zinc-400">
        <i class="fas fa-clock"></i>
      </div>
      <h2 class="mb-2 text-lg font-semibold text-zinc-700 dark:text-zinc-300">
        Próximamente
      </h2>
      <p class="text-sm text-zinc-600 dark:text-zinc-400">
        Nuevas herramientas enfocadas en automatización académica, Moodle y
        gestión de archivos.
      </p>
    </div>
  </section>
</div>
