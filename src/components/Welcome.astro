---
import Navbar from "./Navbar.astro";
import ToolCards from "./ToolCards.astro";
---

<div id="container" class="min-h-screen flex flex-col max-w-7xl mx-auto p-6">
  <div class="flex-1 flex items-center justify-center">
    <section class="relative overflow-hidden w-full">
      <!-- Fondo decorativo -->
      <div class="absolute inset-0 -z-10">
        <div
          class="absolute left-1/2 top-1/2 h-auto w-125
             -translate-x-1/2 -translate-y-1/2
             rounded-full bg-purple-500/90 blur-3xl"
        >
        </div>
      </div>

      <!-- Contenido -->
      <div class="mx-auto max-w-5xl px-6 text-center">
        <span
          class="mb-4 inline-block rounded-full bg-purple-100 px-4 py-1
             text-sm font-medium text-purple-700
             dark:bg-purple-500/10 dark:text-purple-400"
        >
          ✨ 100% Gratuito · Sin Registro · Total Privacidad
        </span>

        <h1
          class="mb-6 text-4xl font-bold tracking-tight
             text-zinc-900 sm:text-5xl
             dark:text-zinc-100"
        >
          CLA Tools – Colección de herramientas
        </h1>

        <p
          class="mx-auto mb-10 max-w-2xl text-base
             text-zinc-600 sm:text-lg
             dark:text-zinc-400"
        >
          Plataforma gratuita con herramientas para agilizar la carga de
          actividades y optimizar procesos académicos de forma rápida y
          sencilla.
        </p>

        <!-- CTA -->
        <div class="flex flex-col justify-center gap-4 sm:flex-row">
          <a
            href="#tools-title"
            class="inline-flex items-center justify-center
               rounded-xl bg-purple-600 px-6 py-3
               text-sm font-semibold text-white
               transition hover:bg-purple-700
               focus-visible:outline
               focus-visible:outline-purple-500"
          >
            Ver herramientas
          </a>

          <a
            href="https://github.com/AngelCLA/cla-tools"
            target="_blank"
            class="inline-flex items-center justify-center
               rounded-xl border border-zinc-300 px-6 py-3
               text-sm font-semibold text-zinc-700
               transition hover:bg-zinc-100
               dark:border-zinc-700 dark:text-zinc-300
               dark:hover:bg-zinc-800"
          >
            GitHub
          </a>
        </div>
      </div>
    </section>
  </div>
  <!-- Icono de scroll animado -->
  <div class="flex justify-center pb-16 animate-bounce">
    <a
      href="#tools-title"
      class="text-purple-600 dark:text-purple-400 transition-colors hover:text-purple-700 dark:hover:text-purple-300"
      aria-label="Desplazar hacia herramientas"
    >
      <svg
        class="w-12 h-12"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M19 9l-7 7-7-7"></path>
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M19 15l-7 7-7-7"></path>
      </svg>
    </a>
  </div>
</div>
