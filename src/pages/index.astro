---
export const prerender = true;

import Welcome from "@components/Welcome.astro";
import ToolCards from "@components/ToolCards.astro";
import Layout from "@layouts/Layout.astro";
import AboutSection from "@components/AboutSection.astro";
import Contact from "@components/ContactSection.astro";

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout
  title="CLA Tools - Herramientas Educativas Gratuitas Online"
  description="Plataforma gratuita con herramientas para personal tecnico, administrativo y docente. Convierte DOCX a GIFT para Moodle, une PDFs, convierte texto a HTML y más. Todo gratis y sin registro."
  keywords="herramientas educativas, moodle, pdf, docx, gift, herramientas gratuitas, educación online, Modalidad Mixta, UPMYS, unir pdf, convertir docx a gift, texto a html"
>
  <Welcome />
  <div class="flex flex-col min-h-screen items-center justify-center">
    <ToolCards />
    <AboutSection />
    <Contact />
  </div>
</Layout>
