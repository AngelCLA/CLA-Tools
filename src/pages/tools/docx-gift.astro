---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import ExampleCollapsable from "../../components/ExampleCollapsable.astro";
import commonScript from "../../assets/scripts/common.js?raw";
import docxConverterScript from "../../assets/scripts/docx-gift-converter.js?raw";

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout
  title="Convertir DOCX a GIFT para Moodle | CLA Tools"
  description="Convierte documentos de Word (.docx) al formato GIFT para importar preguntas en Moodle. Herramienta gratuita y fácil de usar."
  keywords="docx a gift, word a gift, moodle, importar preguntas moodle, gift format, converter"
>
  <div class="flex flex-col min-h-full items-center justify-center">
    <div
      class="w-full max-w-6xl shadow-2xl p-4 sm:p-6 rounded-lg flex flex-col items-center justify-center my-8 sm:my-12 md:my-20 mx-4"
    >
      <h3
        class="text-3xl sm:text-4xl md:text-5xl font-bold text-gradient mb-6 text-center"
      >
        Docx a Gift
      </h3>
      <p
        class="mb-6 text-base sm:text-lg md:text-xl font-semibold text-gradient text-center px-4"
      >
        Convierte tus preguntas de Word al formato GIFT de Moodle
        automáticamente
      </p>
      <p class="mb-6 text-sm sm:text-base text-center px-4">
        Formato: Preguntas en <strong>negrita</strong>, respuesta correcta
        <u>subrayada</u>
      </p>
      <ExampleCollapsable />

      <!-- Upload Area -->
      <div
        id="upload-area"
        class="w-full max-w-5xl mt-8 border-2 border-dashed border-purple-300 dark:border-purple-700 bg-purple-50 dark:bg-purple-900/20 rounded-xl p-6 sm:p-8 md:p-12 text-center cursor-pointer transition-all hover:border-purple-500 dark:hover:border-purple-500 hover:bg-purple-100 dark:hover:bg-purple-900/30"
      >
        <div
          class="text-4xl sm:text-5xl md:text-6xl mb-4 text-purple-600 dark:text-purple-400"
        >
          <i class="fas fa-file-word"></i>
        </div>
        <div
          class="text-lg sm:text-xl font-semibold text-zinc-800 dark:text-zinc-200 mb-2"
        >
          Arrastra tu archivo DOCX aquí
        </div>
        <div class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400">
          o haz clic para seleccionar
        </div>
        <input type="file" id="file-input" accept=".docx" class="hidden" />
      </div>

      <!-- File Info -->
      <div
        id="file-info"
        class="flex hidden w-full max-w-5xl mt-4 bg-zinc-100 dark:bg-zinc-800 rounded-lg p-4 items-center justify-between cursor-pointer"
      >
        <span
          id="file-name"
          class="text-zinc-800 dark:text-zinc-200 font-medium"></span>
        <button
          id="remove-file"
          class="text-red-600 dark:text-red-400 hover:text-red-700 dark:hover:text-red-300 transition-colors cursor-pointer"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
              clip-rule="evenodd"></path>
          </svg>
        </button>
      </div>

      <!-- Loading -->
      <div id="loading" class="hidden w-full max-w-5xl mt-8 text-center">
        <div
          class="inline-block w-12 h-12 border-4 border-purple-200 dark:border-purple-800 border-t-purple-600 dark:border-t-purple-400 rounded-full animate-spin"
        >
        </div>
        <p class="mt-4 text-zinc-600 dark:text-zinc-400">
          Procesando archivo...
        </p>
      </div>

      <!-- Success Message -->
      <div
        id="success-message"
        class="hidden items-center justify-center text-center w-full max-w-5xl mt-4 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 text-green-800 dark:text-green-200 rounded-lg p-4"
      >
        ✅ ¡Archivo convertido exitosamente!
      </div>

      <!-- Error Message -->
      <div
        id="error-message"
        class="hidden w-full max-w-5xl mt-4 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 text-red-800 dark:text-red-200 rounded-lg p-4"
      >
      </div>

      <!-- Output Area -->
      <div id="output-area" class="hidden w-full max-w-5xl mt-8">
        <!-- Stats -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
          <div
            class="bg-white dark:bg-zinc-800 rounded-lg p-6 text-center border border-zinc-200 dark:border-zinc-700"
          >
            <div
              id="question-count"
              class="text-2xl sm:text-3xl font-bold text-purple-600 dark:text-purple-400 mb-2"
            >
              0
            </div>
            <div class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400">
              Preguntas
            </div>
          </div>
          <div
            class="bg-white dark:bg-zinc-800 rounded-lg p-6 text-center border border-zinc-200 dark:border-zinc-700"
          >
            <div
              id="correct-count"
              class="text-2xl sm:text-3xl font-bold text-green-600 dark:text-green-400 mb-2"
            >
              0
            </div>
            <div class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400">
              Respuestas correctas
            </div>
          </div>
          <div
            class="bg-white dark:bg-zinc-800 rounded-lg p-6 text-center border border-zinc-200 dark:border-zinc-700"
          >
            <div
              id="answer-count"
              class="text-2xl sm:text-3xl font-bold text-blue-600 dark:text-blue-400 mb-2"
            >
              0
            </div>
            <div class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400">
              Respuestas totales
            </div>
          </div>
        </div>

        <!-- Preview Section -->
        <div
          id="preview-section"
          class="bg-white dark:bg-zinc-800 rounded-lg py-6 mb-6 border border-zinc-200 dark:border-zinc-700"
        >
          <div
            class="text-base sm:text-lg font-semibold text-zinc-800 dark:text-zinc-200 mb-4 flex items-center gap-2 mx-3 sm:mx-6"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path d="M10 12a2 2 0 100-4 2 2 0 000 4z"></path>
              <path
                fill-rule="evenodd"
                d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z"
                clip-rule="evenodd"></path>
            </svg>
            Vista previa de preguntas procesadas:
          </div>
          <div
            id="questions-preview"
            class="max-h-96 overflow-y-auto space-y-4"
          >
            <!-- Las preguntas se insertarán aquí dinámicamente -->
          </div>
        </div>

        <!-- GIFT Output -->
        <textarea
          id="gift-output"
          placeholder="El formato GIFT aparecerá aquí..."
          readonly
          class="w-full h-64 p-4 border border-zinc-300 dark:border-zinc-700 rounded-lg bg-zinc-50 dark:bg-zinc-900 text-zinc-900 dark:text-zinc-100 font-mono text-sm resize-none focus:outline-none focus:ring-2 focus:ring-purple-500"
        ></textarea>

        <!-- Actions -->
        <div class="flex flex-col sm:flex-row gap-4 mt-4">
          <button
            id="copy-btn"
            class="flex-1 cursor-pointer bg-zinc-600 hover:bg-zinc-700 text-white font-semibold py-3 px-6 rounded-lg transition-colors flex items-center justify-center gap-2"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path d="M8 3a1 1 0 011-1h2a1 1 0 110 2H9a1 1 0 01-1-1z"></path>
              <path
                d="M6 3a2 2 0 00-2 2v11a2 2 0 002 2h8a2 2 0 002-2V5a2 2 0 00-2-2 3 3 0 01-3 3H9a3 3 0 01-3-3z"
              ></path>
            </svg>
            Copiar al portapapeles
          </button>
          <button
            id="download-btn"
            class="flex-1 cursor-pointer bg-purple-600 hover:bg-purple-700 text-white font-semibold py-3 px-6 rounded-lg transition-colors flex items-center justify-center gap-2"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path
                fill-rule="evenodd"
                d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z"
                clip-rule="evenodd"></path>
            </svg>
            Descargar archivo .gift
          </button>
        </div>
      </div>
    </div>
  </div>
</Layout>

<!-- Cargar Mammoth.js desde CDN -->
<script
  is:inline
  src="https://cdn.jsdelivr.net/npm/mammoth@1.6.0/mammoth.browser.min.js"
></script>

<!-- Cargar JSZip para leer el contenido interno del DOCX -->
<script
  is:inline
  src="https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js"></script>

<!-- Cargar common.js primero para las utilidades -->
<script is:inline define:vars={{ commonScript }}>
  eval(commonScript);
</script>

<!-- Cargar el conversor DOCX a GIFT -->
<script is:inline define:vars={{ converterScript: docxConverterScript }}>
  eval(converterScript);
</script>
