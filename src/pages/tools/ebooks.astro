---
export const prerender = false;
import Layout from "@layouts/Layout.astro";
import FloatingVideoTutorial from "@components/FloatingVideoTutorial.astro";
---

<Layout
  title="Ebook Studio Pro | CLA Tools"
  description="Visualiza y lee tus archivos PDF con una experiencia de libro real directamente en el navegador."
  keywords="lector pdf, ebook reader, libro virtual, visualizador pdf, herramienta educativa"
>
  <!-- Font Awesome CDN -->
  <link
    slot="head"
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
  />

  <!-- Estilos personalizados para el lector de ebooks -->
  <style is:global>
    :root {
      --page-color: #ffffff;
      --cover-color: #1a1c20;
      --duration: 0.8s;
      --book-width: 900px;
      --book-height: 600px;
      --accent-color: #9333ea;
    }

    #ebook-tool-container {
      @apply flex flex-col w-full max-w-6xl mx-auto;
    }

    #viewport {
      perspective: 2500px;
      @apply flex items-center justify-center p-4 sm:p-8;
      min-height: 650px;
    }

    .book {
      position: relative;
      width: var(--book-width);
      height: var(--book-height);
      transform-style: preserve-3d;
      display: flex;
      justify-content: flex-end;
    }

    .leaf {
      position: absolute;
      top: 0;
      right: 0;
      width: 50%;
      height: 100%;
      transform-style: preserve-3d;
      transform-origin: left center;
      transition: transform var(--duration) cubic-bezier(0.645, 0.045, 0.355, 1);
      z-index: 1;
    }

    .page-front,
    .page-back {
      position: absolute;
      width: 100%;
      height: 100%;
      top: 0;
      left: 0;
      backface-visibility: hidden;
      background: var(--page-color);
      display: flex;
      justify-content: center;
      align-items: center;
      overflow: hidden;
      box-shadow: inset 5px 0 15px rgba(0, 0, 0, 0.05);
    }

    .page-back {
      transform: rotateY(-180deg);
      border-right: 1px solid rgba(0, 0, 0, 0.1);
    }

    .page-front {
      border-left: 1px solid rgba(0, 0, 0, 0.1);
    }

    .is-cover-front .page-front,
    .is-cover-back .page-back {
      background: var(--cover-color);
      color: white;
      box-shadow:
        inset 0 0 30px rgba(0, 0, 0, 0.5),
        5px 5px 15px rgba(0, 0, 0, 0.3);
    }

    .leaf.flipped {
      transform: rotateY(-180deg);
    }

    .leaf .page-shadow {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 5;
      opacity: 0;
      transition: opacity var(--duration);
    }

    .leaf.flipping .page-shadow {
      opacity: 1;
      background: linear-gradient(
        to right,
        rgba(0, 0, 0, 0) 0%,
        rgba(0, 0, 0, 0.1) 50%,
        rgba(0, 0, 0, 0) 100%
      );
    }

    canvas {
      width: 100% !important;
      height: 100% !important;
      object-fit: contain;
    }

    .spine {
      position: absolute;
      left: 50%;
      top: 0;
      width: 4px;
      height: 100%;
      background: #000;
      z-index: 100;
      transform: translateX(-50%);
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
    }

    .ui-overlay {
      @apply relative mt-6 bg-white/10 dark:bg-black/20 backdrop-blur-xl px-8 py-3 rounded-full flex items-center gap-6 border border-zinc-200/20 dark:border-zinc-700/30 z-[2000] shadow-2xl mx-auto mb-4;
      width: fit-content;
    }

    .progress-container {
      @apply absolute bottom-0 left-10 right-10 h-1 bg-zinc-200/20 dark:bg-zinc-700/30 rounded-full overflow-hidden;
    }

    .progress-bar {
      height: 100%;
      background: linear-gradient(to right, #a855f7, #ec4899);
      width: 0%;
      transition: width 0.4s ease;
    }

    #loading-msg {
      @apply fixed top-10 right-10 bg-purple-600 text-white px-6 py-3 rounded-xl text-sm font-bold hidden z-[3000] shadow-lg animate-pulse;
    }

    .page-counter-badge {
      @apply bg-zinc-100 dark:bg-zinc-800 px-4 py-1.5 rounded-lg border border-zinc-200 dark:border-zinc-700;
    }

    @media (max-width: 1024px) {
      :root {
        --book-width: 90vw;
        --book-height: 60vh;
      }
      #viewport {
        min-height: 400px;
      }
    }
  </style>

  <div class="flex flex-col min-h-full items-center justify-center py-8 px-4">
    <div id="ebook-tool-container" class="w-full">
      <div
        id="setup-view"
        class="w-full max-w-6xl shadow-2xl rounded-xl p-6 sm:p-8 md:p-12 bg-white dark:bg-zinc-900 border border-zinc-100 dark:border-zinc-800"
      >
        <h1
          class="text-3xl sm:text-4xl md:text-5xl font-bold text-gradient mb-4 text-center"
        >
          Ebook Studio Pro
        </h1>
        <p
          class="mb-8 text-base sm:text-lg md:text-xl text-gradient text-center"
        >
          Visualiza tus PDFs con una experiencia de lectura real y envolvente.
        </p>

        <div
          id="drop-area"
          class="border-2 border-dashed border-zinc-300 dark:border-zinc-600 rounded-2xl p-12 sm:p-20 text-center mb-6 cursor-pointer hover:border-purple-500 dark:hover:border-purple-400 transition-all hover:bg-purple-50 dark:hover:bg-purple-900/10 group"
        >
          <input type="file" id="file-selector" class="hidden" accept=".pdf" />
          <div
            class="text-6xl sm:text-7xl mb-6 group-hover:scale-110 transition-transform duration-300"
          >
            <i class="fas fa-book-open text-purple-600 dark:text-purple-400"
            ></i>
          </div>
          <h2
            class="text-xl sm:text-2xl font-bold text-zinc-800 dark:text-zinc-200 mb-4"
          >
            Carga tu archivo PDF
          </h2>
          <p class="text-zinc-500 dark:text-zinc-400 mb-8 max-w-md mx-auto">
            Arrastra el archivo aquí o haz clic para seleccionarlo de tu
            dispositivo. La última página se tratará como contraportada.
          </p>
          <button
            class="bg-purple-600 hover:bg-purple-700 text-white px-10 py-4 rounded-xl font-bold transition-all shadow-lg hover:shadow-purple-500/30"
          >
            Seleccionar PDF
          </button>
        </div>
      </div>

      <div id="reader-view" class="hidden w-full flex flex-col items-center">
        <div id="loading-msg">REESTRUCTURANDO LIBRO...</div>

        <div
          id="viewport"
          class="bg-zinc-50 dark:bg-zinc-950 rounded-2xl shadow-inner border border-zinc-200 dark:border-zinc-800"
        >
          <div class="book" id="book-container">
            <div class="spine"></div>
          </div>
        </div>

        <div class="ui-overlay">
          <button
            id="btn-prev"
            class="text-zinc-600 dark:text-zinc-400 hover:text-purple-600 dark:hover:text-purple-400 transition-colors text-2xl p-2"
            title="Página anterior"
          >
            <i class="fas fa-chevron-left"></i>
          </button>

          <div
            class="text-center min-w-[200px] flex flex-col items-center gap-1"
          >
            <div class="page-counter-badge shadow-sm">
              <span
                id="page-current"
                class="text-[11px] font-extrabold tracking-widest uppercase text-purple-600 dark:text-purple-400"
                >Cargando...</span
              >
            </div>
            <span
              id="page-range"
              class="text-[10px] font-semibold text-zinc-500 dark:text-zinc-400 tracking-wider"
              >0 de 0 páginas</span
            >
          </div>

          <button
            id="btn-next"
            class="text-zinc-600 dark:text-zinc-400 hover:text-purple-600 dark:hover:text-purple-400 transition-colors text-2xl p-2"
            title="Siguiente página"
          >
            <i class="fas fa-chevron-right"></i>
          </button>

          <div class="w-[1px] h-8 bg-zinc-300 dark:bg-zinc-700 mx-2"></div>

          <button
            id="btn-embed"
            class="text-zinc-500 hover:text-blue-500 transition-colors p-2"
            title="Generar Iframe"
          >
            <i class="fas fa-code text-xl"></i>
          </button>

          <button
            onclick="location.reload()"
            class="text-zinc-500 hover:text-red-500 transition-colors p-2"
            title="Cerrar libro"
          >
            <i class="fas fa-times-circle text-xl"></i>
          </button>

          <div class="progress-container">
            <div id="progress-bar" class="progress-bar"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal mejorado para Generar Iframe con opción de upload -->
  <div
    id="embed-modal"
    class="fixed inset-0 z-[4000] hidden items-center justify-center p-4 bg-black/60 backdrop-blur-sm"
  >
    <div
      class="bg-white dark:bg-zinc-900 w-full max-w-2xl rounded-2xl shadow-2xl p-6 border border-zinc-200 dark:border-zinc-800 max-h-[90vh] overflow-y-auto"
    >
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-xl font-bold text-zinc-800 dark:text-zinc-100">
          Generar Código de Inserción
        </h3>
        <button
          id="close-embed-modal"
          class="text-zinc-400 hover:text-zinc-600 dark:hover:text-zinc-200"
        >
          <i class="fas fa-times"></i>
        </button>
      </div>

      <!-- Información importante -->
      <div
        class="bg-purple-50 dark:bg-purple-900/20 border border-purple-200 dark:border-purple-800 rounded-lg p-4 mb-6"
      >
        <div class="flex items-start gap-3">
          <i
            class="fas fa-info-circle text-purple-600 dark:text-purple-400 mt-1"
          ></i>
          <div class="flex-1 text-sm text-zinc-700 dark:text-zinc-300">
            <p class="font-semibold mb-2">Para generar un iframe embebible:</p>
            <ol class="list-decimal list-inside space-y-1 ml-2">
              <li>
                Si cargaste un archivo local, debes subirlo primero usando el
                botón de abajo
              </li>
              <li>
                O pega manualmente la URL de un PDF ya alojado en internet
              </li>
              <li>Luego copia el código iframe generado</li>
            </ol>
          </div>
        </div>
      </div>

      <!-- Botón para subir PDF (solo visible si hay archivo local) -->
      <button
        id="upload-pdf-btn"
        class="w-full bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-700 hover:to-pink-700 text-white font-bold py-4 rounded-xl transition-all mb-4 flex items-center justify-center gap-3 shadow-lg hover:shadow-xl"
        style="display: none;"
      >
        <i class="fas fa-cloud-upload-alt text-xl"></i>
        <span>Subir PDF al Servidor</span>
      </button>

      <!-- Estado del upload -->
      <div id="upload-status" class="text-sm text-zinc-500 mb-4 text-center">
      </div>

      <div class="space-y-4">
        <div>
          <label
            class="block text-xs font-bold uppercase tracking-wider text-zinc-400 mb-2"
            >URL del PDF</label
          >
          <input
            type="text"
            id="embed-pdf-url"
            placeholder="https://tu-sitio.com/archivo.pdf"
            class="w-full bg-zinc-50 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-purple-500 dark:text-zinc-200"
          />
          <p class="text-xs text-zinc-400 mt-1">
            Pega aquí la URL del PDF o súbelo usando el botón superior
          </p>
        </div>

        <div>
          <label
            class="block text-xs font-bold uppercase tracking-wider text-zinc-400 mb-2"
            >Código Iframe</label
          >
          <textarea
            id="embed-iframe-code"
            readonly
            rows="5"
            class="w-full bg-zinc-50 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 rounded-lg px-4 py-3 text-xs font-mono focus:outline-none dark:text-zinc-200 resize-none"
          ></textarea>
        </div>

        <button
          id="copy-embed-code"
          class="w-full bg-purple-600 hover:bg-purple-700 text-white font-bold py-3 rounded-xl transition-all flex items-center justify-center gap-2 shadow-lg"
        >
          <i class="fas fa-copy"></i>
          Copiar Código
        </button>

        <!-- Opciones alternativas -->
        <div class="border-t border-zinc-200 dark:border-zinc-700 pt-4 mt-4">
          <p
            class="text-xs font-semibold text-zinc-400 mb-3 uppercase tracking-wider"
          >
            Opciones alternativas de hosting
          </p>
          <div class="space-y-2 text-xs text-zinc-500 dark:text-zinc-400">
            <div class="flex items-start gap-2">
              <i class="fas fa-cloud text-blue-500 mt-0.5"></i>
              <div>
                <span class="font-semibold">Cloudinary:</span>
                <a
                  href="https://cloudinary.com"
                  target="_blank"
                  class="text-blue-500 hover:underline ml-1">cloudinary.com</a
                >
              </div>
            </div>
            <div class="flex items-start gap-2">
              <i class="fas fa-google-drive text-green-500 mt-0.5"></i>
              <div>
                <span class="font-semibold">Google Drive:</span> Sube el PDF y obtén
                un enlace público
              </div>
            </div>
            <div class="flex items-start gap-2">
              <i class="fas fa-github text-zinc-500 mt-0.5"></i>
              <div>
                <span class="font-semibold">GitHub:</span> Sube a un repositorio y
                usa el enlace raw
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <FloatingVideoTutorial
    videoId="VIDEO_ID_HERE"
    title="Cómo usar el Lector de Ebooks"
  />

  <script
    is:inline
    src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"
  ></script>
  <script is:inline>
    if (typeof pdfjsLib !== "undefined") {
      pdfjsLib.GlobalWorkerOptions.workerSrc =
        "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js";
    }
  </script>

  <script>
    import "../../assets/scripts/pdf-viewer.js";
  </script>
</Layout>
