---
export const prerender = true;
import Layout from "@layouts/Layout.astro";
import FloatingVideoTutorial from "@components/FloatingVideoTutorial.astro";
import commonScript from "@assets/scripts/common.js?raw";
import generadorActa from "@assets/scripts/generar-actas.js?raw";
---

<Layout
  title="Generador de Acta de Acuerdos | CLA Tools"
  description="Genera actas de acuerdos académicos con formato profesional. Personaliza criterios de evaluación, unidades y evidencias. Imprime o descarga en PDF."
  keywords="generador acta, acta acuerdos, documento académico, acta escolar, generador pdf"
>
  <script is:inline define:vars={{ generadorActa }}>
    eval(generadorActa);
  </script>

  <!-- Cargar common.js para las utilidades -->
  <script is:inline define:vars={{ commonScript }}>
    eval(commonScript);
  </script>
  <div class="flex flex-col min-h-full items-center justify-center py-8 px-4">
    <div
      class="w-full max-w-7xl bg-white dark:bg-zinc-900 shadow-2xl rounded-xl p-6 sm:p-8 md:p-12"
    >
      <!-- Header -->
      <div
        class="flex flex-col md:flex-row justify-between items-center mb-6 gap-4"
      >
        <div class="text-center md:text-left">
          <h1
            class="no-print text-3xl sm:text-4xl font-bold text-gradient mb-2"
          >
            Generador de Acta de Acuerdos
          </h1>
          <p
            class="no-print text-sm sm:text-base text-zinc-500 dark:text-zinc-400"
          >
            Crea documentos académicos profesionales en minutos.
          </p>
        </div>
        <div
          id="save-status"
          class="no-print opacity-0 transition-opacity duration-300 flex items-center gap-2 px-3 py-1.5 rounded-full bg-green-50 dark:bg-green-900/20 text-green-600 dark:text-green-400 text-xs font-medium border border-green-100 dark:border-green-800"
        >
          <svg
            class="w-3.5 h-3.5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M5 13l4 4L19 7"></path>
          </svg>
          Cambios guardados
        </div>
      </div>

      <!-- Instructions -->
      <div
        class="no-print bg-purple-50 dark:bg-purple-900/20 border border-purple-200 dark:border-purple-700 rounded-lg p-4 sm:p-6 mb-6"
      >
        <p class="font-semibold text-purple-800 dark:text-purple-300 mb-2">
          📌 Instrucciones:
        </p>
        <ol
          class="list-decimal list-inside space-y-2 text-sm sm:text-base text-zinc-700 dark:text-zinc-300"
        >
          <li>Completa los datos principales de la materia y carrera.</li>
          <li>Configura los porcentajes de evaluación según tu criterio.</li>
          <li>Establece las fechas de corte y recuperación del periodo.</li>
          <li>Personaliza las unidades y evidencias de la asignatura.</li>
          <li>Indica el número de alumnos para la tabla de firmas.</li>
          <li>Visualiza la vista previa y descarga o imprime el documento.</li>
        </ol>
      </div>

      <!-- Tabs -->
      <div
        class="no-print flex border-b border-zinc-300 dark:border-zinc-600 mb-6"
      >
        <button
          data-tab="form"
          class="tab-button px-6 py-3 cursor-pointer font-semibold border-b-2 border-purple-600 text-purple-600 dark:border-purple-400 dark:text-purple-400 transition"
        >
          📝 Configuración
        </button>
        <button
          data-tab="preview"
          class="tab-button px-6 py-3 cursor-pointer font-semibold border-b-2 border-transparent text-zinc-600 dark:text-zinc-400 hover:text-purple-600 dark:hover:text-purple-400 transition"
        >
          👁️ Vista Previa
        </button>
      </div>

      <!-- Form Tab Content -->
      <div data-tab-content="form" class="no-print tab-content">
        <!-- Layout de 2 columnas en desktop -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <!-- Columna Izquierda -->
          <div class="space-y-6">
            <!-- Datos Principales -->
            <div class="fade-in">
              <div class="section-title">
                <svg
                  class="w-5 h-5 text-purple-600 dark:text-purple-400"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z"
                    clip-rule="evenodd"></path>
                </svg>
                Datos Principales
              </div>
              <div class="space-y-3">
                <div>
                  <label class="form-label">URL Logo (opcional)</label>
                  <input
                    type="text"
                    id="logoUrl"
                    class="form-input"
                    value="https://static.wixstatic.com/media/38837b_df7d67422665440a99fd48193b02cb1d~mv2.png/v1/crop/x_24,y_0,w_784,h_492/fill/w_280,h_168,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/38837b_df7d67422665440a99fd48193b02cb1d~mv2.png"
                    placeholder="URL de la imagen"
                  />
                </div>
                <div class="grid grid-cols-2 gap-3">
                  <div>
                    <label class="form-label flex items-center gap-1">
                      Materia
                      <span
                        class="text-zinc-400"
                        title="Nombre oficial de la asignatura">ⓘ</span
                      >
                    </label>
                    <input
                      type="text"
                      id="materia"
                      class="form-input"
                      value="Programación Web"
                    />
                  </div>

                  <div>
                    <label class="form-label flex items-center gap-1">
                      Nombre del Docente
                      <span
                        class="text-zinc-400"
                        title="Nombre completo con grado académico">ⓘ</span
                      >
                    </label>
                    <input
                      type="text"
                      id="docente"
                      class="form-input"
                      value="Ing. Luis Angel Cebreros Carrillo"
                    />
                  </div>
                </div>
                <div>
                  <label class="form-label">Carrera</label>
                  <input
                    type="text"
                    id="carrera"
                    class="form-input"
                    value="INGENIERIA EN TECNOLOGIAS DE LA INFORMACIÓN"
                  />
                </div>
                <div class="grid grid-cols-2 gap-3">
                  <div>
                    <label class="form-label">Grupo</label>
                    <input
                      type="text"
                      id="grupo"
                      class="form-input"
                      value="ITI07"
                    />
                  </div>
                  <div>
                    <label class="form-label">Número de Alumnos</label>
                    <input
                      type="number"
                      id="numAlumnos"
                      class="form-input"
                      value="20"
                      min="1"
                    />
                  </div>
                </div>
                <div class="grid grid-cols-2 gap-3">
                  <div>
                    <label class="form-label">Periodo</label>
                    <input
                      type="text"
                      id="periodoEval"
                      class="form-input"
                      value="enero-abril 2026"
                    />
                  </div>
                  <div>
                    <label class="form-label">Fecha de Elaboración</label>
                    <input
                      type="text"
                      id="fechaCelebracion"
                      class="form-input"
                      value="5 de enero de 2026"
                    />
                  </div>
                </div>
                <div class="grid grid-cols-2 gap-3">
                  <div>
                    <label class="form-label">Hora Inicio</label>
                    <input
                      type="text"
                      id="horaIni"
                      class="form-input"
                      value="10:10"
                    />
                  </div>
                  <div>
                    <label class="form-label">Hora Fin</label>
                    <input
                      type="text"
                      id="horaFin"
                      class="form-input"
                      value="10:30"
                    />
                  </div>
                </div>
              </div>
            </div>

            <!-- Porcentajes -->
            <div class="fade-in">
              <div class="section-title justify-between">
                <div class="flex items-center gap-2">
                  <svg
                    class="w-5 h-5 text-purple-600 dark:text-purple-400"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      d="M2 11a1 1 0 011-1h2a1 1 0 011 1v5a1 1 0 01-1 1H3a1 1 0 01-1-1v-5zM8 7a1 1 0 011-1h2a1 1 0 011 1v9a1 1 0 01-1 1H9a1 1 0 01-1-1V7zM14 4a1 1 0 011-1h2a1 1 0 011 1v12a1 1 0 01-1 1h-2a1 1 0 01-1-1V4z"
                    ></path>
                  </svg>
                  Porcentajes de Evaluación
                </div>
                <span
                  id="percentage-total"
                  class="text-xs font-bold px-2 py-1 rounded bg-zinc-100 dark:bg-zinc-800"
                  >Total: 100%</span
                >
              </div>
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class="form-label">Producto</label>
                  <input
                    type="number"
                    id="p_producto"
                    class="form-input"
                    value="40"
                  />
                </div>
                <div>
                  <label class="form-label">Conocimiento</label>
                  <input
                    type="number"
                    id="p_conocimiento"
                    class="form-input"
                    value="30"
                  />
                </div>
                <div>
                  <label class="form-label">Desempeño</label>
                  <input
                    type="number"
                    id="p_desempeno"
                    class="form-input"
                    value="20"
                  />
                </div>
                <div>
                  <label class="form-label">Actitudinal</label>
                  <input
                    type="number"
                    id="p_actitudinal"
                    class="form-input"
                    value="10"
                  />
                </div>
              </div>
            </div>
          </div>

          <!-- Columna Derecha -->
          <div class="space-y-6">
            <!-- Fechas de Corte -->
            <div class="fade-in">
              <div class="section-title">
                <svg
                  class="w-5 h-5 text-purple-600 dark:text-purple-400"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z"
                    clip-rule="evenodd"></path>
                </svg>
                Fechas de Corte y Recuperación
              </div>
              <div class="space-y-3">
                <div class="grid grid-cols-2 gap-3">
                  <div>
                    <label class="form-label">Corte 1</label>
                    <input
                      type="text"
                      id="c1"
                      class="form-input"
                      value="03 de octubre"
                    />
                  </div>
                  <div>
                    <label class="form-label">Recuperación 1</label>
                    <input
                      type="text"
                      id="r1"
                      class="form-input"
                      value="07 de Octubre"
                    />
                  </div>
                </div>
                <div class="grid grid-cols-2 gap-3">
                  <div>
                    <label class="form-label">Corte 2</label>
                    <input
                      type="text"
                      id="c2"
                      class="form-input"
                      value="07 de noviembre"
                    />
                  </div>
                  <div>
                    <label class="form-label">Recuperación 2</label>
                    <input
                      type="text"
                      id="r2"
                      class="form-input"
                      value="11 de Noviembre"
                    />
                  </div>
                </div>
                <div class="grid grid-cols-2 gap-3">
                  <div>
                    <label class="form-label">Corte 3</label>
                    <input
                      type="text"
                      id="c3"
                      class="form-input"
                      value="16 de diciembre"
                    />
                  </div>
                  <div>
                    <label class="form-label">Recuperación 3</label>
                    <input
                      type="text"
                      id="r3"
                      class="form-input"
                      value="18 de Diciembre"
                    />
                  </div>
                </div>
              </div>
            </div>

            <!-- Unidades -->
            <div class="fade-in">
              <div class="section-title">
                <svg
                  class="w-5 h-5 text-purple-600 dark:text-purple-400"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    d="M9 4.804A7.968 7.968 0 005.5 4c-1.255 0-2.443.29-3.5.804v10A7.969 7.969 0 015.5 14c1.669 0 3.218.51 4.5 1.385A7.962 7.962 0 0114.5 14c1.255 0 2.443.29 3.5.804v-10A7.968 7.968 0 0014.5 4c-1.255 0-2.443.29-3.5.804V12a1 1 0 11-2 0V4.804z"
                  ></path>
                </svg>
                Unidades y Evidencias
              </div>
              <div
                id="units-list"
                class="space-y-3 mb-3 max-h-[500px] overflow-y-auto pr-2"
              >
              </div>
              <button
                id="add-unit-btn"
                class="btn-secondary w-full justify-center"
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path
                    fill-rule="evenodd"
                    d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z"
                    clip-rule="evenodd"></path>
                </svg>
                Agregar Unidad
              </button>
            </div>
          </div>
        </div>

        <!-- Botón Imprimir - Full width abajo -->
        <div class="mt-6 flex flex-col sm:flex-row gap-4">
          <button
            id="print-btn"
            class="btn-primary flex-1 justify-center py-3 text-base shadow-lg"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path
                fill-rule="evenodd"
                d="M5 4v3H4a2 2 0 00-2 2v3a2 2 0 002 2h1v2a2 2 0 002 2h6a2 2 0 002-2v-2h1a2 2 0 002-2V9a2 2 0 00-2-2h-1V4a2 2 0 00-2-2H7a2 2 0 00-2 2zm8 0H7v3h6V4zm0 8H7v4h6v-4z"
                clip-rule="evenodd"></path>
            </svg>
            Imprimir / Guardar PDF
          </button>
          <button
            id="restore-example-btn"
            class="btn-secondary justify-center py-3 px-8 text-base"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path
                fill-rule="evenodd"
                d="M4 2a1 1 0 011 1v2.101a7.002 7.002 0 0111.601 2.566 1 1 0 11-1.885.666A5.002 5.002 0 005.999 7H9a1 1 0 110 2H4a1 1 0 01-1-1V3a1 1 0 011-1zm.008 9.057a1 1 0 011.276.61A5.002 5.002 0 0014.001 13H11a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0v-2.101a7.002 7.002 0 01-11.601-2.566 1 1 0 01.61-1.276z"
                clip-rule="evenodd"></path>
            </svg>
            Restaurar Ejemplo
          </button>
          <button
            id="clear-btn"
            class="btn-secondary justify-center py-3 px-8 text-base border-red-500 text-red-500 hover:bg-red-50 dark:hover:bg-red-900/20 dark:border-red-400 dark:text-red-400"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path
                fill-rule="evenodd"
                d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z"
                clip-rule="evenodd"></path>
            </svg>
            Limpiar Datos
          </button>
        </div>
      </div>

      <!-- Preview Tab Content -->
      <div data-tab-content="preview" class="tab-content hidden">
        <div class="preview-container max-w-3xl mx-auto">
          <div
            id="preview-container"
            class="print-page page-document"
            style="padding: 1cm;"
          >
            <!-- Contenido dinámico -->
          </div>
        </div>
      </div>

      <FloatingVideoTutorial
        platform="cloudflare"
        videoId="https://pub-1b3b05f6637d4bfd8338551a124b9d88.r2.dev/videos/index.m3u8"
        title="Cómo usar esta herramienta"
        class="no-print"
      />
    </div>
  </div>

  <style>
    @media print {
      .no-print {
        display: none !important;
      }

      /* Asegurar que el preview siempre sea visible al imprimir */
      [data-tab-content="preview"] {
        display: block !important;
      }

      body {
        background: white !important;
        padding: 0 !important;
        margin: 0 !important;
      }

      .preview-container {
        max-width: none !important;
        background: white !important;
        box-shadow: none !important;
        border-radius: 0 !important;
      }

      .print-page {
        width: 100% !important;
        max-width: none !important;
        margin: 0 !important;
        padding: 0 !important;
        box-shadow: none !important;
        border: none !important;
        min-height: auto !important;
        background: white !important;
      }

      .page-document {
        box-shadow: none !important;
      }

      /* Eliminar cualquier efecto visual */
      * {
        box-shadow: none !important;
        text-shadow: none !important;
      }

      .page-break {
        page-break-before: always !important;
        break-before: page !important;
        padding-top: 0;
        margin-top: 0;
      }

      @page {
        size: letter;
        margin: 1cm 2cm 2.5cm 1cm;
      }

      /* Hacer que los encabezados y pies de página del navegador sean blancos (invisibles) */
      @page {
        color: white;
      }

      p {
        page-break-inside: avoid;
        orphans: 3;
        widows: 3;
      }

      table {
        page-break-inside: auto;
      }

      tr {
        page-break-inside: avoid;
        page-break-after: auto;
      }

      thead {
        display: table-header-group;
      }

      * {
        color: black !important;
      }
    }

    .print-page {
      font-family: "Times New Roman", Times, serif;
      line-height: 1.3;
      color: black;
      text-align: justify;
    }

    .form-label {
      display: block;
      font-size: 0.875rem;
      font-weight: 600;
      margin-bottom: 0.5rem;
      @apply text-zinc-700 dark:text-zinc-300;
    }

    .form-input,
    .form-textarea {
      width: 100%;
      padding: 0.625rem 0.875rem;
      border-radius: 0.5rem;
      font-size: 0.875rem;
      transition: all 0.2s ease;
      @apply border border-zinc-300 dark:border-zinc-600 bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100;
    }

    .form-input:focus,
    .form-textarea:focus {
      outline: none;
      @apply border-purple-500 dark:border-purple-400 ring-2 ring-purple-500/20 dark:ring-purple-400/20;
    }

    .form-textarea {
      resize: vertical;
      min-height: 60px;
      font-family: inherit;
    }

    .unit-card {
      border-radius: 0.75rem;
      padding: 1rem;
      margin-bottom: 0.75rem;
      transition: all 0.2s ease;
      @apply bg-zinc-50 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700;
    }

    .unit-card:hover {
      @apply border-purple-300 dark:border-purple-600 shadow-md;
    }

    .section-title {
      font-size: 1rem;
      font-weight: 700;
      margin-bottom: 1rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding-bottom: 0.75rem;
      @apply text-zinc-800 dark:text-zinc-200 border-b-2 border-zinc-200 dark:border-zinc-700;
    }

    .btn-primary {
      background: linear-gradient(135deg, #9333ea 0%, #7e22ce 100%);
      color: white;
      padding: 0.625rem 1.25rem;
      border-radius: 0.5rem;
      font-size: 0.875rem;
      font-weight: 600;
      border: none;
      cursor: pointer;
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }

    .btn-primary:hover {
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(147, 51, 234, 0.4);
    }

    .btn-secondary {
      padding: 0.5rem 1rem;
      border-radius: 0.5rem;
      font-size: 0.8125rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      @apply bg-white dark:bg-zinc-800 text-purple-600 dark:text-purple-400 border border-purple-600 dark:border-purple-400;
    }

    .btn-secondary:hover {
      @apply bg-purple-50 dark:bg-purple-900/20;
    }

    .btn-danger {
      font-size: 0.8125rem;
      font-weight: 600;
      background: transparent;
      border: none;
      cursor: pointer;
      transition: all 0.2s ease;
      padding: 0.375rem 0.625rem;
      border-radius: 0.375rem;
      @apply text-red-600 dark:text-red-400;
    }

    .btn-danger:hover {
      @apply bg-red-50 dark:bg-red-900/20;
    }

    .preview-container {
      border-radius: 1rem;
      overflow: hidden;
      @apply bg-zinc-100 dark:bg-zinc-800 shadow-lg;
    }

    .page-document {
      background: white;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
    }

    .fade-in {
      animation: fadeIn 0.3s ease-in;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(-10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .evidence-item {
      border-radius: 0.5rem;
      padding: 0.75rem;
      margin-bottom: 0.5rem;
      @apply bg-zinc-100 dark:bg-zinc-700 border border-zinc-200 dark:border-zinc-600;
    }

    /* Scrollbar personalizado para la lista de unidades */
    #units-list::-webkit-scrollbar {
      width: 8px;
    }

    #units-list::-webkit-scrollbar-track {
      @apply bg-zinc-200 dark:bg-zinc-700 rounded;
    }

    #units-list::-webkit-scrollbar-thumb {
      @apply bg-purple-400 dark:bg-purple-600 rounded;
    }

    #units-list::-webkit-scrollbar-thumb:hover {
      @apply bg-purple-500 dark:bg-purple-500;
    }
  </style>
</Layout>
