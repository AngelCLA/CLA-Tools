<script is:inline define:vars={{ moodlePlaygroundScript }}>
  eval(moodlePlaygroundScript);

  // Tab switching functionality
  const tabButtons = document.querySelectorAll("[data-tab]");
  const tabContents = document.querySelectorAll("[data-tab-content]");

  tabButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const tabName = button.getAttribute("data-tab");

      // Remove active state from all buttons
      tabButtons.forEach((btn) => {
        btn.classList.remove(
          "border-purple-600",
          "text-purple-600",
          "dark:border-purple-400",
          "dark:text-purple-400",
        );
        btn.classList.add(
          "border-transparent",
          "text-zinc-600",
          "dark:text-zinc-400",
        );
      });

      // Hide all tab contents
      tabContents.forEach((content) => {
        content.classList.add("hidden");
      });

      // Activate current button
      button.classList.remove(
        "border-transparent",
        "text-zinc-600",
        "dark:text-zinc-400",
      );
      button.classList.add(
        "border-purple-600",
        "text-purple-600",
        "dark:border-purple-400",
        "dark:text-purple-400",
      );

      // Show current tab content
      document
        .querySelector(`[data-tab-content="${tabName}"]`)
        .classList.remove("hidden");
    });
  });

  // Theme switching functionality for Moodle simulator
  const themeButtons = document.querySelectorAll(".theme-btn");
  const themePreviews = document.querySelectorAll(".moodle-theme-preview");

  themeButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const themeName = button.getAttribute("data-theme");

      // Remove active state from all buttons
      themeButtons.forEach((btn) => {
        btn.classList.remove(
          "bg-purple-600",
          "border-purple-600",
          "text-white",
        );
        btn.classList.add(
          "border-zinc-300",
          "dark:border-zinc-600",
          "text-zinc-700",
          "dark:text-zinc-300",
        );
      });

      // Hide all theme previews
      themePreviews.forEach((preview) => {
        preview.classList.add("hidden");
      });

      // Activate current button
      button.classList.remove(
        "border-zinc-300",
        "dark:border-zinc-600",
        "text-zinc-700",
        "dark:text-zinc-300",
      );
      button.classList.add("bg-purple-600", "border-purple-600", "text-white");

      // Show current theme preview
      document.getElementById(`theme-${themeName}`).classList.remove("hidden");

      // Update iframes with content
      const content = document.getElementById("iframe-input").value;
      const iframeId = `${themeName}-preview`;
      const iframe = document.getElementById(iframeId);
      if (iframe) {
        iframe.srcdoc =
          content ||
          '<p style="color: #999; padding: 20px;">No hay contenido</p>';
      }
    });
  });

   // Update preview button handler
   document
     .getElementById("update-preview-btn")
     .addEventListener("click", () => {
       const content = document.getElementById("iframe-input").value;
       const rawPreview = document.getElementById("raw-preview");

       // Update raw preview
       if (rawPreview) {
         rawPreview.srcdoc =
           content ||
           '<p style="color: #999; padding: 20px;">No hay contenido</p>';
       }

       // Update all moodle theme previews
       const iframeIds = [
         "klass-preview",
         "boost-preview",
         "moove-preview",
         "adapt-preview",
       ];
       iframeIds.forEach((id) => {
         const iframe = document.getElementById(id);
         if (iframe) {
           iframe.srcdoc =
             content ||
             '<p style="color: #999; padding: 20px;">No hay contenido</p>';
         }
       });

       // Switch to moodle tab
       const moodleTab = document.querySelector('[data-tab="moodle"]');
       if (moodleTab) {
         moodleTab.click();
       }

       // Scroll to moodle content
       setTimeout(() => {
         const moodleContainer = document.querySelector('[data-tab-content="moodle"]');
         if (moodleContainer) {
           moodleContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
         }
       }, 100);

       // Show success message
       const successMsg = document.getElementById("success-message");
       successMsg.classList.remove("hidden");
       setTimeout(() => {
         successMsg.classList.add("hidden");
       }, 2000);
     });

   // Clear editor button handler
   document.getElementById("clear-editor-btn").addEventListener("click", () => {
     document.getElementById("iframe-input").value = "";
     const iframeIds = [
       "raw-preview",
       "klass-preview",
       "boost-preview",
       "moove-preview",
       "adapt-preview",
     ];
     iframeIds.forEach((id) => {
       const iframe = document.getElementById(id);
       if (iframe) {
         iframe.srcdoc = "";
       }
     });
     updateButtonStates();
   });

   // Update button states based on content
   function updateButtonStates() {
     const textarea = document.getElementById("iframe-input");
     const updateBtn = document.getElementById("update-preview-btn");
     const clearBtn = document.getElementById("clear-editor-btn");
     
     const hasContent = textarea.value.trim().length > 0;
     
     updateBtn.disabled = !hasContent;
     clearBtn.disabled = !hasContent;
   }

   // Check button states on textarea input
   document.getElementById("iframe-input").addEventListener("input", updateButtonStates);

   // Initialize button states on page load
   updateButtonStates();

  // Set initial active theme
  const firstThemePreview = document.getElementById("theme-klass");
  if (firstThemePreview) {
    firstThemePreview.classList.remove("hidden");
  }

  // Height slider functionality for preview tab
  const previewHeightSlider = document.getElementById("preview-height-slider");
  const previewHeightValue = document.getElementById("preview-height-value");
  const rawPreviewIframe = document.getElementById("raw-preview");

  if (previewHeightSlider) {
    previewHeightSlider.addEventListener("input", (e) => {
      const height = e.target.value;
      previewHeightValue.textContent = height + "px";
      if (rawPreviewIframe) {
        rawPreviewIframe.style.height = height + "px";
      }
    });
  }

  // Height slider functionality for moodle tab
  const moodleHeightSlider = document.getElementById("moodle-height-slider");
  const moodleHeightValue = document.getElementById("moodle-height-value");
  const iframeIds = [
    "klass-preview",
    "boost-preview",
    "moove-preview",
    "adapt-preview",
  ];

  if (moodleHeightSlider) {
    moodleHeightSlider.addEventListener("input", (e) => {
      const height = e.target.value;
      moodleHeightValue.textContent = height + "px";
      iframeIds.forEach((id) => {
        const iframe = document.getElementById(id);
        if (iframe) {
          iframe.setAttribute("height", height);
        }
      });
    });
  }
</script>
