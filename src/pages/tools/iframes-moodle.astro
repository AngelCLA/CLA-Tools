  <div class="moodle-playground">
    <!-- Header -->
    <header class="mp-header">
      <div class="mp-logo">
        <div class="mp-logo-dot"></div>
        Moodle Playground
      </div>
      <div class="mp-view-toggle">
        <button class="mp-view-btn" id="vbtn-editor" onclick="setLayout('editor')">
          Editor
        </button>
        <button class="mp-view-btn active" id="vbtn-split" onclick="setLayout('split')">
          Split
        </button>
        <button class="mp-view-btn" id="vbtn-preview" onclick="setLayout('preview')">
          Preview
        </button>
      </div>
      <div class="mp-header-sep"></div>
      <button class="mp-btn mp-btn-outline" onclick="clearAll()">Limpiar</button>
      <button class="mp-btn mp-btn-run" onclick="runCode()">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor">
          <polygon points="2,1 11,6 2,11"></polygon>
        </svg>
        Ejecutar
      </button>
    </header>

    <!-- Workspace -->
    <div class="mp-workspace" id="workspace">
      <!-- Editor Panel -->
      <div class="mp-editor-panel" id="editor-panel">
        <div class="mp-code-tabs">
          <div class="mp-code-tab">
            <div class="mp-tab-dot"></div>
            HTML — iframe
          </div>
        </div>
        <div class="mp-code-editors">
          <div class="mp-code-area">
            <div class="mp-line-numbers-wrap">
              <div class="mp-line-numbers" id="ln-html">1</div>
              <textarea
                class="mp-editor"
                id="ed-html"
                spellcheck="false"
                placeholder="Pega aquí tu iframe o HTML..."
                oninput="updateLines()"
                onscroll="syncScroll()"
                onkeydown="handleTab(event)"></textarea>
            </div>
          </div>
        </div>
      </div>

      <!-- Resize Bar -->
      <div class="mp-resize-bar" id="resize-bar" onmousedown="startResize(event)">
      </div>

      <!-- Preview Panel -->
      <div class="mp-preview-panel" id="preview-panel">
        <div class="mp-preview-tabs">
          <button
            class="mp-preview-tab active"
            id="ptab-raw"
            onclick="setPreviewMode('raw')">
            Vista directa
          </button>
          <button
            class="mp-preview-tab"
            id="ptab-moodle"
            onclick="setPreviewMode('moodle')">
            🎓 Simulador Moodle
          </button>
          <div id="theme-controls" class="mp-theme-controls">
            <div class="mp-theme-sep"></div>
            <button class="mp-theme-btn active" id="tbtn-klass" onclick="setTheme('klass')">
              Klass
            </button>
            <button class="mp-theme-btn" id="tbtn-boost" onclick="setTheme('boost')">
              Boost
            </button>
            <button class="mp-theme-btn" id="tbtn-moove" onclick="setTheme('moove')">
              Moove
            </button>
            <button class="mp-theme-btn" id="tbtn-adaptable" onclick="setTheme('adaptable')">
              Adaptable
            </button>
          </div>
          <div class="mp-height-ctrl" id="height-ctrl">
            <label>Alto:</label>
            <input
              type="range"
              id="h-range"
              min="150"
              max="900"
              value="500"
              step="10"
              oninput="updateIframeHeight(this.value)" />
            <span class="val" id="ih-val">500px</span>
          </div>
        </div>

        <div class="mp-preview-content">
          <!-- Raw Preview iframe -->
          <iframe id="raw-preview" sandbox="allow-scripts allow-forms allow-modals allow-same-origin">
          </iframe>

          <!-- ═══ KLASS THEME ═══ -->
